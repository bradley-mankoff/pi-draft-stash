  "bugs": {
    "url": "https://github.com/bradley-mankoff/pi-draft-stash/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "stash",
    "draft",
    "prompt",
    "images"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "extensions",
    "lib",
    "README.md",
    "LICENSE"
  ],
